{
  "name": "Product",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome do produto"
    },
    "code": {
      "type": "string",
      "description": "C\u00f3digo do produto"
    },
    "category": {
      "type": "string",
      "enum": [
        "Eletr\u00f4nicos",
        "Ferramentas",
        "Material de Escrit\u00f3rio",
        "Limpeza",
        "EPI",
        "Outros"
      ],
      "description": "Categoria do produto"
    },
    "quantity": {
      "type": "number",
      "default": 0,
      "description": "Quantidade em estoque"
    },
    "min_quantity": {
      "type": "number",
      "default": 5,
      "description": "Quantidade m\u00ednima antes do alerta"
    },
    "unit": {
      "type": "string",
      "enum": [
        "unidade",
        "caixa",
        "pacote",
        "litro",
        "kg"
      ],
      "default": "unidade",
      "description": "Unidade de medida"
    },
    "location": {
      "type": "string",
      "description": "Localiza\u00e7\u00e3o no estoque"
    },
    "image_url": {
      "type": "string",
      "description": "URL da imagem do produto"
    }
  },
  "required": [
    "name",
    "code"
  ]
}
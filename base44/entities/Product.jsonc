{
  "name": "Product",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome do produto"
    },
    "code": {
      "type": "string",
      "description": "C\u00f3digo do produto"
    },
    "category": {
      "type": "string",
      "description": "Categoria do produto"
    },
    "quantity": {
      "type": "number",
      "default": 0,
      "description": "Quantidade em estoque (dep\u00f3sito)"
    },
    "min_quantity": {
      "type": "number",
      "default": 5,
      "description": "Quantidade m\u00ednima antes do alerta"
    },
    "unit": {
      "type": "string",
      "enum": [
        "unidade",
        "caixa",
        "pacote",
        "litro",
        "kg"
      ],
      "default": "unidade",
      "description": "Unidade de medida"
    },
    "manufacturer_name": {
      "type": "string",
      "description": "Nome do fabricante"
    },
    "manufacturer_code": {
      "type": "string",
      "description": "C\u00f3digo do fabricante"
    },
    "image_url": {
      "type": "string",
      "description": "URL da imagem do produto"
    }
  },
  "required": [
    "name",
    "code"
  ]
}
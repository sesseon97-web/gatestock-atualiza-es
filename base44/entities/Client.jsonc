{
  "name": "Client",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome do cliente"
    },
    "email": {
      "type": "string",
      "description": "Email de login do cliente (deve ser o mesmo email cadastrado como usu\u00e1rio)"
    },
    "report_email": {
      "type": "string",
      "description": "Email para envio de relat\u00f3rios (pode ser diferente do email de login)"
    },
    "app_username": {
      "type": "string",
      "description": "Usu\u00e1rio para o segundo login interno do app"
    },
    "app_password": {
      "type": "string",
      "description": "Senha para o segundo login interno do app (armazenada em texto simples)"
    },
    "company": {
      "type": "string",
      "description": "Empresa ou setor do cliente"
    },
    "ip_address": {
      "type": "string",
      "description": "Endere\u00e7o IP ou URL para acionar a porta/atuador do cliente"
    },
    "ip_port": {
      "type": "string",
      "description": "Porta do IP (ex: 8080)"
    },
    "ip_endpoint": {
      "type": "string",
      "description": "Endpoint do IP (ex: /open ou /trigger)"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Cliente ativo"
    },
    "notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es sobre o cliente"
    },
    "representative_id": {
      "type": "string",
      "description": "ID do usu\u00e1rio representante respons\u00e1vel por este cliente"
    },
    "representative_name": {
      "type": "string",
      "description": "Nome do representante respons\u00e1vel"
    },
    "contract_url": {
      "type": "string",
      "description": "URL do contrato anexado para este cliente"
    }
  },
  "required": [
    "name",
    "email"
  ]
}